{
  "manifest_version": 3,
  "name": "Wayground Helper (Firefox)",
  "version": "0.3.0",
  "description": "Page interaction customization with selectable site scope for Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "wayground-helper@example.org",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://wayground.com/*",
    "*://*.wayground.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Wayground Helper Settings",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
