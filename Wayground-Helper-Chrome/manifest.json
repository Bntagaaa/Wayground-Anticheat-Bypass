{
  "manifest_version": 3,
  "name": "Wayground-Helper",
  "version": "0.2.0",
  "description": "Page interaction customization with selectable site scope.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://wayground.com/*",
    "*://*.wayground.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Wayground Helper Settings",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
